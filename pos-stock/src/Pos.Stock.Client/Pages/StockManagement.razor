@page "/stock"
@inject ApiClient Api

<PageTitle>Stock</PageTitle>

<h1>Stock</h1>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (info is not null)
{
    <div class="alert alert-success" role="status">@info</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Stock adjustment</h5>
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Product</label>
                <select class="form-select" @bind="adjustment.ProductId">
                    <option value="0">Select product...</option>
                    @foreach (var product in products)
                    {
                        <option value="@product.Id">@($"{product.Sku} - {product.Name} (stock: {product.StockQuantity})")</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Type</label>
                <select class="form-select" @bind="adjustment.Type">
                    <option value="Purchase">Purchase</option>
                    <option value="Return">Return</option>
                    <option value="Adjustment">Adjustment</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Quantity</label>
                <input class="form-control" type="number" @bind="adjustment.Quantity" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Reason</label>
                <input class="form-control" @bind="adjustment.Reason" />
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary w-100" @onclick="SubmitAsync">Save</button>
            </div>
        </div>
        <div class="form-text mt-2">
            Purchase and Return add stock. Adjustment uses the sign you type: a negative number removes stock (damage, loss).
        </div>
    </div>
</div>

<h4>Low stock</h4>

@if (lowStock.Count == 0)
{
    <p class="text-muted">Nothing is below its reorder level.</p>
}
else
{
    <table class="table table-sm table-warning align-middle mb-4">
        <thead>
            <tr><th>SKU</th><th>Name</th><th class="text-end">Stock</th><th class="text-end">Reorder level</th></tr>
        </thead>
        <tbody>
            @foreach (var product in lowStock)
            {
                <tr>
                    <td>@product.Sku</td>
                    <td>@product.Name</td>
                    <td class="text-end">@product.StockQuantity</td>
                    <td class="text-end">@product.ReorderLevel</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex align-items-center justify-content-between flex-wrap mb-2">
    <h4 class="mb-0">Movement history</h4>
    <select class="form-select w-auto" @bind="filterProductId" @bind:after="LoadMovementsAsync">
        <option value="">All products</option>
        @foreach (var product in products)
        {
            <option value="@product.Id">@($"{product.Sku} - {product.Name}")</option>
        }
    </select>
</div>

@if (movements.Count == 0)
{
    <p class="text-muted">No movements yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr><th>Date</th><th>Product</th><th>Type</th><th class="text-end">Quantity</th><th>Reason</th></tr>
            </thead>
            <tbody>
                @foreach (var movement in movements)
                {
                    <tr>
                        <td>@movement.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>@ProductName(movement.ProductId)</td>
                        <td>@movement.Type</td>
                        <td class="text-end">@(movement.Quantity > 0 ? "+" : "")@movement.Quantity</td>
                        <td>@movement.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProductDto> products = new();
    private List<ProductDto> lowStock = new();
    private List<StockMovementDto> movements = new();
    private StockAdjustmentForm adjustment = new();
    private int? filterProductId;
    private string? error;
    private string? info;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAllAsync();
    }

    private async Task ReloadAllAsync()
    {
        var productsResult = await Api.GetProductsAsync();

        if (productsResult.Ok)
        {
            products = productsResult.Value;
        }
        else
        {
            error = productsResult.Error;
        }

        var lowStockResult = await Api.GetLowStockAsync();

        if (lowStockResult.Ok)
        {
            lowStock = lowStockResult.Value;
        }

        await LoadMovementsAsync();
    }

    private async Task LoadMovementsAsync()
    {
        var result = await Api.GetMovementsAsync(filterProductId);

        if (result.Ok)
        {
            movements = result.Value;
        }
        else
        {
            error = result.Error;
        }
    }

    private string ProductName(int productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        return product is null ? $"#{productId}" : product.Name;
    }

    private async Task SubmitAsync()
    {
        error = null;
        info = null;

        if (adjustment.ProductId == 0)
        {
            error = "Select a product first.";
            return;
        }

        if (adjustment.Quantity == 0)
        {
            error = "Quantity cannot be zero.";
            return;
        }

        var result = await Api.AdjustStockAsync(adjustment);

        if (!result.Ok)
        {
            error = result.Error;
            return;
        }

        info = "Stock updated.";
        adjustment = new StockAdjustmentForm();
        await ReloadAllAsync();
    }
}
