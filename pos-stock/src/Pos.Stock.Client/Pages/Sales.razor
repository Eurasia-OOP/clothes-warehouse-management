@page "/sales"
@inject ApiClient Api

<PageTitle>Sales</PageTitle>

<h1>Sales</h1>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Daily report</h5>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input class="form-control w-auto" type="date" @bind="reportDate" />
            <button class="btn btn-primary" @onclick="LoadReportAsync">Show</button>
        </div>

        @if (report is not null)
        {
            <p class="mt-3 mb-0">
                <strong>@report.Date</strong>: @report.SalesCount sale(s), total <strong>@report.Total.ToString("N2")</strong>
            </p>
        }
    </div>
</div>

<h4>Recent sales</h4>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (sales.Count == 0)
{
    <p class="text-muted">No sales yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr><th>#</th><th>Date</th><th>Payment</th><th class="text-end">Items</th><th class="text-end">Total</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var sale in sales)
                {
                    <tr>
                        <td>@sale.Id</td>
                        <td>@sale.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>@sale.PaymentMethod</td>
                        <td class="text-end">@sale.Items.Sum(i => i.Quantity)</td>
                        <td class="text-end">@sale.Total.ToString("N2")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Toggle(sale.Id)">
                                @(expandedId == sale.Id ? "Hide" : "Details")
                            </button>
                        </td>
                    </tr>
                    if (expandedId == sale.Id)
                    {
                        <tr>
                            <td colspan="6">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr><th>Product</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Line total</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in sale.Items)
                                        {
                                            <tr>
                                                <td>@ProductName(item.ProductId)</td>
                                                <td class="text-end">@item.Quantity</td>
                                                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                                <td class="text-end">@item.LineTotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<SaleDto> sales = new();
    private List<ProductDto> products = new();
    private DailyReportDto? report;
    private DateOnly reportDate = DateOnly.FromDateTime(DateTime.Today);
    private int? expandedId;
    private string? error;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var productsResult = await Api.GetProductsAsync();

        if (productsResult.Ok)
        {
            products = productsResult.Value;
        }

        var salesResult = await Api.GetSalesAsync();

        if (salesResult.Ok)
        {
            sales = salesResult.Value;
        }
        else
        {
            error = salesResult.Error;
        }

        isLoading = false;

        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        var result = await Api.GetDailyReportAsync(reportDate);

        if (result.Ok)
        {
            report = result.Value;
        }
        else
        {
            error = result.Error;
        }
    }

    private void Toggle(int saleId)
    {
        expandedId = expandedId == saleId ? null : saleId;
    }

    private string ProductName(int productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        return product is null ? $"#{productId}" : product.Name;
    }
}
