@page "/"

<PageTitle>Home</PageTitle>

<h1>Point of Sale &amp; Stock</h1>

<p class="lead">Clothes warehouse management: products, stock and sales.</p>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Point of sale</h5>
            <p class="card-text">Build a cart, choose the payment method and complete a sale. Stock is reduced automatically.</p>
            <a class="btn btn-primary" href="pos">Open</a>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Products and categories</h5>
            <p class="card-text">Add, edit and deactivate products, and organise them into categories.</p>
            <a class="btn btn-outline-primary" href="products">Products</a>
            <a class="btn btn-outline-primary" href="categories">Categories</a>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Stock and sales</h5>
            <p class="card-text">Register deliveries and adjustments, see low stock, movement history and sales reports.</p>
            <a class="btn btn-outline-primary" href="stock">Stock</a>
            <a class="btn btn-outline-primary" href="sales">Sales</a>
        </div></div>
    </div>
</div>
